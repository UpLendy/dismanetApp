# Base de datos
# Puerto 5435 (no 5432) para no chocar con un Postgres nativo del host.
DATABASE_URL="postgresql://dismanet:dismanet@localhost:5435/dismanet?schema=public"

# Clave de firma de sesiones (JWT). Generar con:
#   openssl rand -hex 32
JWT_SECRET=""

# Clave de cifrado reversible para contraseñas de cuentas y pines de perfil.
# 32 bytes en hexadecimal. Generar con:
#   openssl rand -hex 32
#
# ADVERTENCIA: si se pierde esta clave, las contraseñas y pines guardados en la
# base de datos son IRRECUPERABLES. Guardarla fuera del repositorio.
CLAVE_CIFRADO=""

# Credenciales que crea el seed (SUPER_ADMIN de la plataforma, y el ADMIN /
# VENDEDOR de ejemplo de la empresa demo DISMANET).
#
# Los valores de abajo son los que usa el seed en desarrollo si estas
# variables no están definidas. En producción (NODE_ENV=production) el seed
# NO admite ese valor de desarrollo: si falta cualquiera de estas variables,
# falla en vez de crear una cuenta con una contraseña que es pública en este
# repositorio.
SEED_SUPERADMIN_EMAIL="admin@plataforma.local"
SEED_SUPERADMIN_PASSWORD="cambiar-en-produccion"
SEED_ADMIN_EMAIL="admin@dismanet.local"
SEED_ADMIN_PASSWORD="cambiar-en-produccion"
SEED_VENDEDOR_EMAIL="vendedor@dismanet.local"
SEED_VENDEDOR_PASSWORD="cambiar-en-produccion"

# URL pública del API para el frontend
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Origen del frontend, para el CORS del API (credentials: true exige un
# origen explícito, no "*")
WEB_URL="http://localhost:3000"

# Lista blanca de orígenes permitidos para peticiones que cambian estado
# (POST/PUT/PATCH/DELETE), separados por coma — defensa en profundidad
# contra CSRF, independiente de la cookie de sesión (ver
# src/plugins/origen.ts). Opcional: si no se define, cae a WEB_URL. Solo
# hace falta declararla aparte cuando hay más de un origen válido (ej.
# producción + una vista previa de Vercel).
# ORIGENES_PERMITIDOS="https://app.dismanet.com,https://dismanet-preview.vercel.app"
