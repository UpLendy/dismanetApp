{
  "name": "dismanet-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "bun run --cwd apps/api prisma generate",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "seed": "bun run --cwd apps/api seed",
    "test": "bun test"
  }
}
