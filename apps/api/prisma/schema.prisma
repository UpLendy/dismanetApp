// Esquema de datos — Sistema Interno de Gestión, MVP módulo de ventas.
// Ver PRD-MVP-Ventas.md sección 4 y CLAUDE.md para las reglas no negociables (R1-R5).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Rol {
  SUPER_ADMIN
  ADMIN
  EMPLEADO
  VENDEDOR
}

enum UnidadDuracion {
  DIAS
  MESES
}

enum TipoVenta {
  UNIDAD
  PAQUETE
}

enum TipoPlantilla {
  UNIDAD
  PAQUETE
}

enum TipoMovimientoSaldo {
  CARGA
  CONSUMO
  DEVOLUCION
  AJUSTE
}

enum EstadoHoraAdicional {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoArchivoInstruccion {
  IMAGEN
  VIDEO
}

// ---------------------------------------------------------------------------
// Empresa y Usuario
// ---------------------------------------------------------------------------

model Empresa {
  id                 String   @id @default(cuid())
  nombre             String
  nit                String?
  prefijoCodigo      String   @db.VarChar(3)
  activa             Boolean  @default(true)
  creadaPorUsuarioId String?
  createdAt          DateTime @default(now())

  creadaPor Usuario? @relation("EmpresasCreadas", fields: [creadaPorUsuarioId], references: [id])

  usuarios                   Usuario[]                   @relation("UsuariosDeEmpresa")
  plataformas                Plataforma[]
  duraciones                 Duracion[]
  tiposCliente               TipoCliente[]
  cargos                     Cargo[]
  paquetes                   Paquete[]
  paquetePlataformas         PaquetePlataforma[]
  paqueteDuracionPlataformas PaqueteDuracionPlataforma[]
  precios                    Precio[]
  costosPlataforma           CostoPlataforma[]
  cuentas                    Cuenta[]
  pantallas                  Pantalla[]
  pantallasPlantilla         PlataformaPantalla[]
  ventas                     Venta[]
  ventaDetalles              VentaDetalle[]
  plantillasMensaje          PlantillaMensaje[]
  movimientoSaldos           MovimientoSaldo[]
  garantias                  Garantia[]
  reiniciosCuenta            ReinicioCuenta[]
  turnos                     Turno[]
  festivos                   Festivo[]
  horasAdicionales           HoraAdicional[]
  reportesSemanales          ReporteSemanal[]
  configuracionesComision    ConfiguracionComision[]
  instrucciones              Instruccion[]
  instruccionArchivos        InstruccionArchivo[]
  instruccionCumplimientos   InstruccionCumplimiento[]
  instruccionVisualizaciones InstruccionVisualizacion[]

  @@unique([prefijoCodigo])
}

// empresaId es nulo únicamente para SUPER_ADMIN, que no pertenece a ninguna empresa.
model Usuario {
  id           String   @id @default(cuid())
  empresaId    String?
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  /// Se incrementa al cambiar la propia contraseña (PUT /perfil/contrasena).
  /// El JWT lleva el valor vigente al firmarse; si no coincide con este
  /// campo, la sesión quedó invalidada (ver plugins/contexto.ts). Es lo que
  /// permite "cerrar las demás sesiones" sin un almacén de sesiones aparte.
  versionSesion Int @default(1)

  /// OBSOLETA desde la división de roles VENDEDOR/EMPLEADO: la distinción
  /// revendedor-con-saldo vs. empleado-sin-tope ahora la da `rol` (VENDEDOR
  /// usa saldo, EMPLEADO nunca) — ver la migración de datos
  /// 20261009164941_rol_migrar_empleados_sin_saldo. Ningún archivo bajo
  /// src/ lee esta columna (ver lib/usa-saldo-lista-blanca.test.ts). No se
  /// borra porque hay filas históricas que todavía la tienen poblada.
  usaSaldo Boolean @default(false)
  /// Saldo vigente, en pesos. Los movimientos (MovimientoSaldo) son la
  /// historia; este campo es el valor actual, redundante a propósito para
  /// poder auditar sin recalcular (ver MovimientoSaldo.saldoResultante).
  saldo    Decimal @default(0) @db.Decimal(14, 2)

  /// El oficio, no el permiso (ver Cargo). Nullable: los usuarios ya
  /// existentes no tienen uno y eso es válido.
  cargoId String?

  empresa Empresa? @relation("UsuariosDeEmpresa", fields: [empresaId], references: [id])
  cargo   Cargo?   @relation(fields: [cargoId], references: [id])

  empresasCreadas Empresa[] @relation("EmpresasCreadas")

  ventasComoVendedor             Venta[]                   @relation("VentaVendedor")
  ventasAnuladas                 Venta[]                   @relation("VentaAnuladaPor")
  movimientosSaldo               MovimientoSaldo[]         @relation("MovimientoSaldoUsuario")
  movimientosSaldoCreados        MovimientoSaldo[]         @relation("MovimientoSaldoCreadoPor")
  garantiasCreadas               Garantia[]                @relation("GarantiaCreadaPor")
  reiniciosCuenta                ReinicioCuenta[]          @relation("ReinicioCuentaUsuario")
  turnos                         Turno[]
  horasAdicionalesRegistradas    HoraAdicional[]           @relation("HoraAdicionalUsuario")
  horasAdicionalesRevisadas      HoraAdicional[]           @relation("HoraAdicionalRevisor")
  reportesSemanales              ReporteSemanal[]
  configuracionesComisionCreadas ConfiguracionComision[]
  instruccionesCreadas           Instruccion[]             @relation("InstruccionCreadaPor")
  instruccionArchivosSubidos     InstruccionArchivo[]      @relation("InstruccionArchivoSubidoPor")
  instruccionCumplimientos       InstruccionCumplimiento[]
  instruccionVisualizaciones     InstruccionVisualizacion[]

  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

/// nombreMensaje: nombre decorado para el mensaje de WhatsApp, ej. "N.E.T.F.L.I.X".
/// Si es null se usa `nombre`.
/// condiciones: texto que se muestra al vendedor antes de vender, ej. "1 pantalla. Solo TV".
/// usaPerfilPin: false para plataformas como Spotify, Canva, YouTube.
/// logoUrl: ruta bajo /logos/<archivo> (apps/web/public/logos/) o URL externa.
/// Null hasta que un admin la configure; sin logo el grid muestra una
/// pastilla con la inicial del nombre (vender/page.tsx), nunca un ícono roto.
model Plataforma {
  id                 String  @id @default(cuid())
  empresaId          String
  nombre             String
  nombreMensaje      String?
  condiciones        String?
  capacidadPantallas Int
  usaPerfilPin       Boolean @default(false)
  /// Qué campos de acceso usa esta plataforma (F4.2, parte 1): controla qué
  /// pide el formulario de Cuenta, qué exige la validación en cuentas.ts, y
  /// qué bloques del mensaje de WhatsApp sobreviven a
  /// quitarBloquesDeCamposNoUsados(). usaCorreo es el único true por
  /// defecto porque es el campo que ya existía antes de F4.2.
  usaCorreo          Boolean @default(true)
  usaUsuario         Boolean @default(false)
  usaCodigo          Boolean @default(false)
  usaEnlace          Boolean @default(false)
  activa             Boolean @default(true)
  logoUrl            String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  paquetePlataformas         PaquetePlataforma[]
  paqueteDuracionPlataformas PaqueteDuracionPlataforma[]
  precios                    Precio[]
  costosPlataforma           CostoPlataforma[]
  cuentas                    Cuenta[]
  ventas                     Venta[]
  ventaDetalles              VentaDetalle[]
  pantallasPlantilla         PlataformaPantalla[]
  garantiasExternas          Garantia[]

  @@index([empresaId])
}

/// Plantilla de pantallas de una plataforma: todas las cuentas nuevas de esa
/// plataforma generan sus Pantalla copiando estas filas (numero, perfil,
/// pin). Editar la plantilla no toca ninguna Pantalla ya creada (R3: una
/// pantalla vendida ya entregó su PIN al comprador por WhatsApp) — ver
/// POST /cuentas en src/routes/cuentas.ts, que es el único lugar que lee
/// esta tabla para copiarla.
model PlataformaPantalla {
  id           String  @id @default(cuid())
  empresaId    String
  plataformaId String
  numero       Int
  perfil       String?
  /// Cifrado reversible (AES-256-GCM), igual que Pantalla.pin.
  pin          String?

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])

  @@unique([plataformaId, numero])
  @@index([empresaId])
}

model Duracion {
  id        String         @id @default(cuid())
  empresaId String
  nombre    String
  cantidad  Int
  unidad    UnidadDuracion
  activa    Boolean        @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  precios                Precio[]
  costosPlataforma       CostoPlataforma[]
  paqueteDuracionVendida PaqueteDuracionPlataforma[] @relation("DuracionVendida")
  paqueteDuracionReal    PaqueteDuracionPlataforma[] @relation("DuracionReal")
  ventas                 Venta[]
  ventaDetalles          VentaDetalle[]

  @@index([empresaId])
}

model TipoCliente {
  id        String  @id @default(cuid())
  empresaId String
  nombre    String
  activo    Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  precios Precio[]
  ventas  Venta[]

  @@index([empresaId])
}

/// El oficio (Gerencia, Coordinación, Soporte técnico...), no la escala de
/// permisos: eso es Rol (ver CLAUDE.md, "la decisión que define esta
/// entrega"). Un Cargo no ordena nada ni concede nada por sí mismo.
model Cargo {
  id        String   @id @default(cuid())
  empresaId String
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])

  usuarios      Usuario[]
  instrucciones Instruccion[]

  @@index([empresaId])
}

model Paquete {
  id          String  @id @default(cuid())
  empresaId   String
  nombre      String
  descripcion String?
  activo      Boolean @default(true)
  /// Qué ES este ítem hoy. No confundir con Venta.esPromocion, que es la
  /// copia inmutable de QUÉ ERA al momento de vender (R3).
  esPromocion Boolean @default(false)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  paquetePlataformas         PaquetePlataforma[]
  paqueteDuracionPlataformas PaqueteDuracionPlataforma[]
  precios                    Precio[]
  ventas                     Venta[]

  @@index([empresaId])
}

/// Composición del paquete: qué plataformas lo integran y cuántas pantallas de cada una.
model PaquetePlataforma {
  id                String @id @default(cuid())
  empresaId         String
  paqueteId         String
  plataformaId      String
  cantidadPantallas Int    @default(1)

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  paquete    Paquete    @relation(fields: [paqueteId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])

  @@unique([paqueteId, plataformaId])
  @@index([empresaId])
}

/// Excepciones de duración por plataforma dentro de un paquete.
/// Solo lleva filas donde la duración real DIFIERE de la duración vendida.
/// Ej.: paquete "Básico 1" vendido a "30 días" (duracionVendidaId) con
/// Netflix (plataformaId) resolviendo a "28 días" (duracionRealId).
model PaqueteDuracionPlataforma {
  id                String @id @default(cuid())
  empresaId         String
  paqueteId         String
  duracionVendidaId String
  plataformaId      String
  duracionRealId    String

  empresa         Empresa    @relation(fields: [empresaId], references: [id])
  paquete         Paquete    @relation(fields: [paqueteId], references: [id])
  duracionVendida Duracion   @relation("DuracionVendida", fields: [duracionVendidaId], references: [id])
  plataforma      Plataforma @relation(fields: [plataformaId], references: [id])
  duracionReal    Duracion   @relation("DuracionReal", fields: [duracionRealId], references: [id])

  @@unique([paqueteId, duracionVendidaId, plataformaId])
  @@index([empresaId])
}

/// Precio sirve tanto para plataformas individuales como para paquetes.
/// plataformaId y paqueteId son ambos nullable: exactamente uno debe estar
/// presente. Esa restricción se aplica con un CHECK de Postgres agregado en
/// una migración SQL manual (Prisma no expresa CHECK arbitrarios en el
/// esquema) — ver prisma/migrations/*_check_precio_plataforma_xor_paquete.
model Precio {
  id            String  @id @default(cuid())
  empresaId     String
  plataformaId  String?
  paqueteId     String?
  duracionId    String
  tipoClienteId String
  precioVenta   Decimal @db.Decimal(14, 2)
  costo         Decimal @db.Decimal(14, 2)
  activo        Boolean @default(true)

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  plataforma  Plataforma? @relation(fields: [plataformaId], references: [id])
  paquete     Paquete?    @relation(fields: [paqueteId], references: [id])
  duracion    Duracion    @relation(fields: [duracionId], references: [id])
  tipoCliente TipoCliente @relation(fields: [tipoClienteId], references: [id])

  @@unique([empresaId, plataformaId, duracionId, tipoClienteId])
  @@unique([empresaId, paqueteId, duracionId, tipoClienteId])
  @@index([empresaId])
}

/// Costo por plataforma+duración — el costo no depende del tipo de cliente,
/// a diferencia de Precio.precioVenta. Reemplaza a Precio.costo como fuente
/// de costo en todo el código de negocio (Precio.costo queda sin leerse,
/// ver lib/precio-costo-lista-blanca.test.ts, pendiente de eliminar columna).
model CostoPlataforma {
  id           String  @id @default(cuid())
  empresaId    String
  plataformaId String
  duracionId   String
  costo        Decimal @db.Decimal(14, 2)

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])
  duracion   Duracion   @relation(fields: [duracionId], references: [id])

  @@unique([empresaId, plataformaId, duracionId])
  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// Inventario
// ---------------------------------------------------------------------------

model Cuenta {
  id                 String   @id @default(cuid())
  empresaId          String
  plataformaId       String
  /// Nullable desde F4.2: obligatorio solo si Plataforma.usaCorreo = true.
  /// La validación real (obligatorio/prohibido según la plataforma) vive en
  /// el handler de cuentas.ts, no aquí — depende de la plataforma cargada.
  correo             String?
  usuario            String?
  /// Cifrado reversible (AES-256-GCM), igual que password — ver src/lib/cifrado.ts.
  codigo             String?
  /// Texto plano a propósito: es una URL, no un secreto (F4.2, parte 1.1).
  enlace             String?
  /// Cifrado reversible (AES-256-GCM), no hash — ver src/lib/cifrado.ts.
  /// Nunca nullable: toda cuenta tiene contraseña de la plataforma, sin
  /// importar qué otros campos declare usaX.
  password           String
  capacidadPantallas Int
  notas              String?
  activa             Boolean  @default(true)
  createdAt          DateTime @default(now())

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])

  pantallas       Pantalla[]
  ventaDetalles   VentaDetalle[]
  reiniciosCuenta ReinicioCuenta[]

  @@index([empresaId])
}

/// Unidad de inventario. Perfil y PIN son null cuando la plataforma no usa
/// perfiles (Plataforma.usaPerfilPin = false).
model Pantalla {
  id        String  @id @default(cuid())
  empresaId String
  cuentaId  String
  numero    Int
  perfil    String?
  /// Cifrado reversible (AES-256-GCM), no hash.
  pin       String?
  activa    Boolean @default(true)

  /// F4.11 — último momento en que un operador devolvió esta pantalla al
  /// inventario reiniciando la cuenta (cambiando la contraseña en el
  /// proveedor). Nulo = nunca se ha reiniciado. R5 usa este campo, no
  /// Venta.fechaVencimientoMax, para decidir disponibilidad: ver
  /// src/lib/pantallas.ts.
  liberadaEn DateTime?

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cuenta  Cuenta  @relation(fields: [cuentaId], references: [id])

  ventaDetalles VentaDetalle[]

  @@unique([cuentaId, numero])
  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// Ventas
// ---------------------------------------------------------------------------

/// Guarda copia de precioVenta, costo, utilidad, cantidadDuracion,
/// unidadDuracion, nombreItem, nombreDuracion y nombreTipoCliente al momento
/// de la venta (R3): esos campos nunca se actualizan después de creados.
///
/// fechaVencimientoMax = mayor vencimiento de sus VentaDetalle. Es un valor
/// derivado que se escribe una sola vez al crear la venta, solo para filtrar
/// y ordenar listados. La disponibilidad de una pantalla NUNCA se calcula con
/// este campo — usar siempre VentaDetalle.fechaVencimiento (R5).
model Venta {
  id            String    @id @default(cuid())
  empresaId     String
  vendedorId    String
  codigoCompra  String
  tipoVenta     TipoVenta
  plataformaId  String?
  paqueteId     String?
  duracionId    String
  tipoClienteId String?

  /// Venta creada únicamente para sostener una garantía de una venta hecha
  /// fuera del sistema (F4.3). precioVenta/costo/utilidad son cero: no es un
  /// ingreso. Se excluye de listados y totales.
  esExterna Boolean @default(false)

  // Copias inmutables al momento de la venta (R3).
  nombreItem        String
  nombreDuracion    String
  cantidadDuracion  Int
  unidadDuracion    UnidadDuracion
  nombreTipoCliente String
  /// Suma de precios de catálogo de los renglones vendidos (F4.4). Antes de
  /// F4.4 no existía forma de descontar, así que en todo lo histórico
  /// precioSugerido == precioVenta. El descuento no se guarda: se deriva
  /// como precioSugerido - precioVenta (puede ser negativo: un recargo).
  precioSugerido    Decimal        @db.Decimal(14, 2)
  precioVenta       Decimal        @db.Decimal(14, 2)
  costo             Decimal        @db.Decimal(14, 2)
  utilidad          Decimal        @db.Decimal(14, 2)
  /// Copia de Paquete.esPromocion al momento de vender. Si el admin
  /// desmarca la promoción después, esta venta sigue contando como
  /// promoción (R3). Siempre false para tipoVenta UNIDAD.
  esPromocion       Boolean        @default(false)

  /// Celular del comprador final, opcional. Primer dato personal del
  /// comprador que guarda el sistema: solo visible para el vendedor autor
  /// de la venta y para ADMIN/SUPER_ADMIN (R4).
  celularCliente String?

  fechaVenta          DateTime @default(now())
  /// Derivado, solo para filtrar/ordenar. NUNCA usar para disponibilidad (R5).
  fechaVencimientoMax DateTime

  mensajeGenerado String @db.Text

  anulada      Boolean   @default(false)
  anuladaPorId String?
  anuladaEn    DateTime?
  createdAt    DateTime  @default(now())

  empresa     Empresa      @relation(fields: [empresaId], references: [id])
  vendedor    Usuario      @relation("VentaVendedor", fields: [vendedorId], references: [id])
  anuladaPor  Usuario?     @relation("VentaAnuladaPor", fields: [anuladaPorId], references: [id])
  plataforma  Plataforma?  @relation(fields: [plataformaId], references: [id])
  paquete     Paquete?     @relation(fields: [paqueteId], references: [id])
  duracion    Duracion     @relation(fields: [duracionId], references: [id])
  tipoCliente TipoCliente? @relation(fields: [tipoClienteId], references: [id])

  detalles         VentaDetalle[]
  movimientosSaldo MovimientoSaldo[]

  @@unique([empresaId, codigoCompra])
  @@index([empresaId])
}

/// Una fila por pantalla asignada. Cada renglón lleva SU PROPIA duración y
/// fecha de vencimiento (R5/D14): un combo puede tener Netflix a 28 días y
/// Disney+ a 30 días en la misma venta. Guarda copia de nombrePlataforma,
/// correoCuenta, passwordCuenta, perfil y pin — inmutables (R3).
model VentaDetalle {
  id           String @id @default(cuid())
  empresaId    String
  ventaId      String
  pantallaId   String
  cuentaId     String
  plataformaId String

  // Copias inmutables al momento de la venta (R3).
  nombrePlataforma String
  correoCuenta     String?
  usuarioCuenta    String?
  /// Cifrado reversible (AES-256-GCM), copiado de Cuenta.codigo al vender.
  codigoCuenta     String?
  enlaceCuenta     String?
  /// Cifrado reversible (AES-256-GCM), copiado de Cuenta.password al vender.
  passwordCuenta   String
  perfil           String?
  /// Cifrado reversible (AES-256-GCM), copiado de Pantalla.pin al vender.
  pin              String?

  duracionId       String
  cantidadDuracion Int
  unidadDuracion   UnidadDuracion
  /// Fuente de verdad de disponibilidad (R5): ocupada si venta no anulada y
  /// fechaVencimiento > now().
  fechaVencimiento DateTime

  /// Copias inmutables por renglón (R3, F4.4). Nulas en las ventas
  /// anteriores a F4.4 y en las de tipoVenta PAQUETE: el precio de un
  /// paquete no se puede atribuir por plataforma sin inventarlo. Null
  /// significa "sin desglose", no cero — F4.5 tiene que tratarlo así.
  precioSugerido Decimal? @db.Decimal(14, 2)
  /// Nulo en lo anterior a F4.4, y también (F4.7) cuando no existe
  /// CostoPlataforma para esa plataforma/duración al momento de la venta.
  /// Null significa "costo no atribuible", no cero — estadisticas-ventas.ts
  /// lo cuenta en renglonesSinCostoAtribuible, nunca lo suma como $0.
  costo          Decimal? @db.Decimal(14, 2)

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  venta      Venta      @relation(fields: [ventaId], references: [id])
  pantalla   Pantalla   @relation(fields: [pantallaId], references: [id])
  cuenta     Cuenta     @relation(fields: [cuentaId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])
  duracion   Duracion   @relation(fields: [duracionId], references: [id])

  /// Presente si esta pantalla falló y fue reemplazada (este renglón es el ORIGINAL).
  garantiaOriginal  Garantia? @relation("GarantiaOriginal")
  /// Presente si este renglón fue entregado como reemplazo de una garantía.
  garantiaReemplazo Garantia? @relation("GarantiaReemplazo")

  @@index([empresaId])
  @@index([pantallaId, fechaVencimiento])
}

/// Reemplazo de una pantalla que dejó de funcionar para el comprador (R3): el
/// VentaDetalle original nunca se toca — ni su pantallaId, ni sus
/// credenciales, ni su fechaVencimiento. El reemplazo es un VentaDetalle
/// NUEVO sobre la MISMA venta; esta fila es el hecho que conecta ambos.
///
/// ventaDetalleOriginalId es único: una pantalla entregada no se reemplaza
/// dos veces. Si el reemplazo también falla, la garantía siguiente apunta al
/// renglón de reemplazo, que es otro id.
model Garantia {
  id                      String   @id @default(cuid())
  empresaId               String
  ventaDetalleOriginalId  String?  @unique
  ventaDetalleReemplazoId String   @unique
  motivo                  String?
  /// Costo de la plataforma/duración al momento de la garantía — copia
  /// inmutable (R3). Es la pérdida que asume la empresa; NO se resta de
  /// Venta.utilidad de la venta original, que es historia y no se edita.
  costoAsumido            Decimal  @db.Decimal(14, 2)
  mensajeGenerado         String   @db.Text
  creadoPorId             String
  createdAt               DateTime @default(now())

  /// Garantía de una venta que ocurrió fuera del sistema (F4.3): no hay
  /// VentaDetalle original que reemplazar, solo la promesa hecha al
  /// comprador.
  esExterna Boolean @default(false)

  /// Datos de la venta original cuando ocurrió fuera del sistema (F4.3).
  /// Nulos en una garantía normal, donde esa información vive en el
  /// VentaDetalle original.
  plataformaExternaId String?
  celularExterno      String?

  empresa               Empresa       @relation(fields: [empresaId], references: [id])
  ventaDetalleOriginal  VentaDetalle? @relation("GarantiaOriginal", fields: [ventaDetalleOriginalId], references: [id])
  ventaDetalleReemplazo VentaDetalle  @relation("GarantiaReemplazo", fields: [ventaDetalleReemplazoId], references: [id])
  creadoPor             Usuario       @relation("GarantiaCreadaPor", fields: [creadoPorId], references: [id])
  plataformaExterna     Plataforma?   @relation(fields: [plataformaExternaId], references: [id])

  @@index([empresaId])
}

/// F4.11 — rastro de auditoría de cada reinicio de cuenta (cambio de
/// contraseña en el proveedor tras rotar las credenciales). Es lo que libera
/// las pantallas POR_REINICIAR de esa cuenta (ver Pantalla.liberadaEn y
/// src/lib/pantallas.ts). codigosCompraAfectados guarda los códigos de las
/// ventas vigentes que quedaron sin acceso por el reinicio — copia
/// inmutable, como las demás copias de R3.
model ReinicioCuenta {
  id                       String   @id @default(cuid())
  empresaId                String
  cuentaId                 String
  usuarioId                String
  pantallasLiberadas       Int
  pantallasConVentaVigente Int
  codigosCompraAfectados   String[]
  createdAt                DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cuenta  Cuenta  @relation(fields: [cuentaId], references: [id])
  usuario Usuario @relation("ReinicioCuentaUsuario", fields: [usuarioId], references: [id])

  @@index([empresaId])
  @@index([cuentaId])
}

/// Texto exacto por tipo de venta, con placeholders {{...}}. Editar la
/// plantilla no cambia Venta.mensajeGenerado de ventas ya registradas (R3).
model PlantillaMensaje {
  id            String        @id @default(cuid())
  empresaId     String
  tipo          TipoPlantilla
  contenido     String        @db.Text
  actualizadaEn DateTime      @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, tipo])
  @@index([empresaId])
}

/// Saldo del "Saldo" (crédito prepago de revendedores). `Usuario.saldo` es el
/// valor vigente; esta tabla es la historia inmutable: un movimiento pasado
/// NUNCA se edita ni se borra, un error se corrige con un AJUSTE nuevo.
///
/// `saldoResultante` es redundante a propósito: es lo que permite auditar el
/// ledger sin recalcular toda la historia (ver prueba de cuadre de ledger).
///
/// No se copia nada de esto a Venta (R3 no aplica aquí): `ventaId` ya
/// responde "qué venta generó este movimiento", y Venta es inmutable por
/// construcción. `ventaId` está presente en CONSUMO y DEVOLUCION, nulo en
/// CARGA y AJUSTE. `nota` es obligatoria en AJUSTE (se exige en la capa de
/// aplicación: Prisma no expresa nulabilidad condicional).
///
/// La restricción única (empresaId, ventaId, tipo) hace estructuralmente
/// imposible cobrar dos veces la misma venta o devolverle el saldo dos
/// veces, incluso bajo una carrera — ver restriccionViolada() en errores.ts.
model MovimientoSaldo {
  id              String              @id @default(cuid())
  empresaId       String
  usuarioId       String
  tipo            TipoMovimientoSaldo
  monto           Decimal             @db.Decimal(14, 2)
  saldoResultante Decimal             @db.Decimal(14, 2)
  ventaId         String?
  nota            String?
  creadoPorId     String
  createdAt       DateTime            @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  usuario   Usuario @relation("MovimientoSaldoUsuario", fields: [usuarioId], references: [id])
  venta     Venta?  @relation(fields: [ventaId], references: [id])
  creadoPor Usuario @relation("MovimientoSaldoCreadoPor", fields: [creadoPorId], references: [id])

  @@unique([empresaId, ventaId, tipo])
  @@index([empresaId])
  @@index([usuarioId])
}

// ---------------------------------------------------------------------------
// Calendario laboral (F6.2)
// ---------------------------------------------------------------------------

/// `inicio`/`fin` son instantes absolutos (no fecha + hora): un turno de
/// 22:00 a 06:00 cruza la medianoche y su duración es una resta simple, sin
/// caso especial nocturno. El día al que pertenece el turno es la fecha en
/// Bogotá de `inicio` (ver lib/periodos.ts, nunca aritmética de zona horaria
/// nueva). Sin solapamiento para el mismo usuario (lib/turnos.ts): esas horas
/// son el denominador del reparto de comisiones, y contarlas dos veces es un
/// error de plata. DELETE sí borra de verdad (routes/turnos.ts): un turno mal
/// digitado es error de captura, no historia del negocio — revisar esta
/// decisión el día que existan comisiones liquidadas sobre un turno.
model Turno {
  id        String   @id @default(cuid())
  empresaId String
  usuarioId String
  inicio    DateTime
  fin       DateTime
  notas     String?
  createdAt DateTime @default(now())

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, usuarioId])
  @@index([empresaId, inicio])
}

/// Festivos colombianos, por empresa (R1) aunque sean nacionales: son ~18
/// filas por año, y así cada empresa corrige los suyos sin tocar a las
/// otras. `fecha` es medianoche Bogotá del día festivo (mismo instante que
/// devuelve inicioDiaBogota para ese día). `generado: false` marca una fila
/// creada o corregida a mano por un ADMIN — POST /festivos/generar nunca la
/// sobrescribe (ver lib/festivos.ts).
model Festivo {
  id        String   @id @default(cuid())
  empresaId String
  fecha     DateTime
  nombre    String
  generado  Boolean  @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, fecha])
  @@index([empresaId])
}

/// Registro de horas adicionales/festivas de planta (F6.3) — NO una nómina.
/// No calcula recargo legal ni clasifica jornada nocturna (CLAUDE.md,
/// PROMPT-F6.3): solo cuántas horas y si el día es festivo o domingo, eso
/// lo decide quien liquida. `inicio`/`fin` son instantes absolutos, igual
/// que Turno y por la misma razón: un bloque puede cruzar la medianoche de
/// un día ordinario a uno festivo.
///
/// IMPORTANTE: estas horas NO entran en el denominador del pozo de
/// comisiones. Ese reparto es por horas de Turno del calendario, como lo
/// pidió el cliente — si HoraAdicional se sumara ahí, cualquiera podría
/// agrandar su propia tajada registrándose horas a sí mismo. No las sumes
/// al calcular comisiones.
///
/// Flujo de aprobación (PENDIENTE/APROBADA/RECHAZADA) agregado por
/// decisión propia, no pedido por el cliente (ver PROMPT-F6.3 parte 0).
/// Solo editable/borrable mientras esté PENDIENTE.
model HoraAdicional {
  id            String              @id @default(cuid())
  empresaId     String
  usuarioId     String
  inicio        DateTime
  fin           DateTime
  motivo        String?
  estado        EstadoHoraAdicional @default(PENDIENTE)
  revisadaPorId String?
  revisadaEn    DateTime?
  createdAt     DateTime            @default(now())

  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  usuario     Usuario  @relation("HoraAdicionalUsuario", fields: [usuarioId], references: [id])
  revisadaPor Usuario? @relation("HoraAdicionalRevisor", fields: [revisadaPorId], references: [id])

  @@index([empresaId, usuarioId])
  @@index([empresaId, inicio])
  @@index([empresaId, estado])
}

/// Testimonio semanal de cada EMPLEADO+ (F6.4, punto 5 del cliente): tres
/// campos de texto separados —pendientes, fallas, oportunidades— porque son
/// las tres cosas que el cliente nombró, y por separado se comparan semana
/// a semana. Cada quien escribe el suyo; ni un ADMIN escribe por otro (ver
/// routes/reportes.ts) — un reporte es el testimonio de quien lo firma.
///
/// `cargoId` es una COPIA al momento de escribir, no una relación viva
/// (mismo principio que Venta.nombreItem, R3 de CLAUDE.md): si a alguien le
/// cambian el cargo después, su reporte ya escrito sigue diciendo el cargo
/// que tenía entonces. Por eso no lleva `@relation` a Cargo.
///
/// `semanaInicio` es el lunes 00:00 Bogotá de la semana que reporta — sale
/// de `inicioSemanaBogota` (lib/periodos.ts), nunca aritmética de semanas
/// nueva. El `@@unique` garantiza un reporte por persona por semana: un
/// segundo PUT de la misma persona y semana actualiza, no crea otro (no se
/// usa `upsert` de Prisma porque la extensión multi-tenant lo bloquea —
/// routes/reportes.ts busca y crea/actualiza a mano).
model ReporteSemanal {
  id            String   @id @default(cuid())
  empresaId     String
  usuarioId     String
  cargoId       String?
  semanaInicio  DateTime
  pendientes    String
  fallas        String
  oportunidades String
  createdAt     DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([empresaId, usuarioId, semanaInicio])
  @@index([empresaId, semanaInicio])
  @@index([empresaId, cargoId, semanaInicio])
}

enum ModoComision {
  PORCENTAJE_VENTA
  FIJO_POR_PANTALLA
}

enum AmbitoUmbral {
  TOTAL
  POR_PLATAFORMA
}

enum PeriodoUmbral {
  DIA
  MES
}

/// Política de comisiones, F6.5. Registro POR VERSIÓN, no una fila que se
/// edita: guardar una política nueva crea otra fila, nunca actualiza la
/// anterior. La vigente es la de vigenteDesde más reciente que ya empezó.
/// Esto paga gente: si el porcentaje cambia a mitad de mes y después se
/// liquida, hay que poder saber qué regla regía cuando se vendió — una fila
/// mutable borra esa respuesta para siempre. No existe comisión por
/// porcentaje de utilidad (descartada por el cliente: R4 existe justamente
/// para que un empleado no pueda despejar la utilidad desde su comisión).
model ConfiguracionComision {
  id             String        @id @default(cuid())
  empresaId      String
  modo           ModoComision
  valor          Decimal       @db.Decimal(14, 2)
  umbralCantidad Int
  umbralAmbito   AmbitoUmbral
  umbralPeriodo  PeriodoUmbral
  vigenteDesde   DateTime
  creadaPorId    String
  createdAt      DateTime      @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  creadaPor Usuario @relation(fields: [creadaPorId], references: [id])

  @@index([empresaId, vigenteDesde])
}

// ---------------------------------------------------------------------------
// Instrucciones semanales (F6.7)
// ---------------------------------------------------------------------------

/// Imágenes y video con tareas que los empleados deben realizar esa semana
/// (primera mitad del punto 7 del cliente). Los archivos NUNCA pasan por el
/// API: van del navegador a S3 con URLs prefirmadas (ver lib/s3.ts,
/// routes/instrucciones.ts) — el API solo valida permisos/tipo/tamaño,
/// genera la clave y firma.
///
/// `semanaInicio` sale de inicioSemanaBogota (lib/periodos.ts), igual que
/// ReporteSemanal (F6.4) — nunca aritmética de semanas nueva.
///
/// `publicada` existe para que el ADMIN prepare la semana antes del lunes
/// sin que nadie la vea a medias: una instrucción no publicada no sale en
/// ninguna consulta de empleado, ni pidiendo su id directo, ni entrega URL
/// de lectura de sus archivos.
///
/// `cargoId` nulo significa "para todos los empleados". No hay tabla de
/// asignación múltiple: el cliente pidió instrucciones semanales para el
/// equipo, no una matriz de asignaciones por persona.
model Instruccion {
  id            String   @id @default(cuid())
  empresaId     String
  titulo        String
  descripcion   String?
  semanaInicio  DateTime
  cargoId       String?
  publicada     Boolean  @default(false)
  creadaPorId   String
  createdAt     DateTime @default(now())
  actualizadaEn DateTime @updatedAt

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  cargo     Cargo?  @relation(fields: [cargoId], references: [id])
  creadaPor Usuario @relation("InstruccionCreadaPor", fields: [creadaPorId], references: [id])

  archivos      InstruccionArchivo[]
  cumplimientos InstruccionCumplimiento[]

  @@index([empresaId, semanaInicio])
  @@index([empresaId, cargoId])
}

/// Un archivo (imagen o video) de una instrucción, ya subido a S3. `clave`
/// es la ruta en el bucket — la genera el servidor, nunca el cliente (regla
/// de seguridad no negociable de PROMPT-F6.7) — con el formato
/// empresas/{empresaId}/instrucciones/{instruccionId}/{uuid}.{ext}. No se
/// guarda ninguna URL: las de lectura se firman al pedirlas y vencen en
/// minutos (ver lib/s3.ts).
model InstruccionArchivo {
  id            String                 @id @default(cuid())
  empresaId     String
  instruccionId String
  tipo             TipoArchivoInstruccion
  clave            String
  nombre           String
  contentType      String
  bytes            Int
  // solo VIDEO. La manda el navegador del ADMIN al registrar el archivo
  // (metadatos del propio video), no el empleado que lo ve — por eso se
  // confía aunque venga del cliente: quien la manda no tiene incentivo para
  // falsearla baja (PROMPT-F6.8, Parte 1.4). Si llega nula o en 0, ese video
  // no puede gatillar cumplimiento automático (lib/visualizacion.ts).
  duracionSegundos Int?
  orden            Int
  subidoPorId      String
  createdAt        DateTime               @default(now())

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  instruccion Instruccion @relation(fields: [instruccionId], references: [id])
  subidoPor   Usuario     @relation("InstruccionArchivoSubidoPor", fields: [subidoPorId], references: [id])

  visualizaciones InstruccionVisualizacion[]

  @@index([empresaId, instruccionId])
}

/// Quién marcó una instrucción como cumplida. Para una instrucción SIN
/// videos, la fila nace de `POST /:id/completar` (autodeclarado). Para una
/// instrucción CON al menos un video (F6.8), esa ruta responde 409: la fila
/// la crea el servidor solo, cuando `InstruccionVisualizacion.completadoEn`
/// queda lleno para todos los videos de la instrucción de ese usuario — ver
/// lib/visualizacion.ts. `@@unique` evita duplicar la fila tanto si alguien
/// marca "completar" dos veces como si dos reportes de progreso casi
/// simultáneos intentan crearla a la vez.
model InstruccionCumplimiento {
  id            String   @id @default(cuid())
  empresaId     String
  instruccionId String
  usuarioId     String
  completadoEn  DateTime @default(now())

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  instruccion Instruccion @relation(fields: [instruccionId], references: [id])
  usuario     Usuario     @relation(fields: [usuarioId], references: [id])

  @@unique([instruccionId, usuarioId])
  @@index([empresaId, instruccionId])
}

/// Registro de visualización de un video (F6.8). NO ES UNA PRUEBA de que
/// alguien vio el video: todo lo que reporta el navegador se puede
/// falsificar desde las herramientas de desarrollador, y no hay forma de
/// verificarlo del lado del servidor. Lo que hace esta tabla, junto con
/// `lib/visualizacion.ts`, es subir el costo de hacer trampa de "cero
/// esfuerzo" (arrastrar la barra al final) a "manipulación deliberada". Que
/// nadie lea este modelo dentro de un año creyendo que es evidencia.
///
/// `tramos` guarda qué PARTES del video se vieron, no la posición máxima
/// alcanzada — si solo guardara "llegó al segundo 600", arrastrar la barra
/// al final completaría el video de inmediato. Fusionados y sin solapar,
/// como máximo 50 (lib/visualizacion.ts: MAXIMO_TRAMOS); un cliente
/// manipulado que mande cientos de fragmentos sueltos se rechaza en vez de
/// crecer sin límite.
///
/// `segundosVistos` es la suma de `tramos`, desnormalizada para consultar sin
/// deserializar el JSON en cada lectura — nunca la fuente de verdad, se
/// recalcula de `tramos` en cada reporte.
///
/// `ultimoReporte` es el reloj del servidor en el reporte anterior: el único
/// control que de verdad sirve (Parte 1.2 de PROMPT-F6.8) compara contra él,
/// nunca contra algo que mande el navegador.
model InstruccionVisualizacion {
  id             String    @id @default(cuid())
  empresaId      String
  archivoId      String
  usuarioId      String
  tramos         Json
  segundosVistos Int       @default(0)
  /// Reloj del servidor en el PRIMER reporte — nunca se reescribe después.
  /// La condición "tiempo real acumulado ≥ 90% de la duración" (Parte 1.3)
  /// se mide contra este campo, no contra `ultimoReporte` (que sí avanza en
  /// cada reporte): es lo que impide completar con reportes frecuentes y
  /// coherentes con el reloj, pero empezados hace apenas un instante.
  primerReporte  DateTime
  ultimoReporte  DateTime
  completadoEn   DateTime?

  empresa Empresa            @relation(fields: [empresaId], references: [id])
  archivo InstruccionArchivo @relation(fields: [archivoId], references: [id])
  usuario Usuario            @relation(fields: [usuarioId], references: [id])

  @@unique([archivoId, usuarioId])
  @@index([empresaId, archivoId])
}
