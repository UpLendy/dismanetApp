// Esquema de datos — Sistema Interno de Gestión, MVP módulo de ventas.
// Ver PRD-MVP-Ventas.md sección 4 y CLAUDE.md para las reglas no negociables (R1-R5).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Rol {
  SUPER_ADMIN
  ADMIN
  EMPLEADO
  VENDEDOR
}

enum UnidadDuracion {
  DIAS
  MESES
}

enum TipoVenta {
  UNIDAD
  PAQUETE
}

enum TipoPlantilla {
  UNIDAD
  PAQUETE
}

enum TipoMovimientoSaldo {
  CARGA
  CONSUMO
  DEVOLUCION
  AJUSTE
}

// ---------------------------------------------------------------------------
// Empresa y Usuario
// ---------------------------------------------------------------------------

model Empresa {
  id                 String   @id @default(cuid())
  nombre             String
  nit                String?
  prefijoCodigo      String   @db.VarChar(3)
  activa             Boolean  @default(true)
  creadaPorUsuarioId String?
  createdAt          DateTime @default(now())

  creadaPor Usuario? @relation("EmpresasCreadas", fields: [creadaPorUsuarioId], references: [id])

  usuarios                   Usuario[]                   @relation("UsuariosDeEmpresa")
  plataformas                Plataforma[]
  duraciones                 Duracion[]
  tiposCliente               TipoCliente[]
  paquetes                   Paquete[]
  paquetePlataformas         PaquetePlataforma[]
  paqueteDuracionPlataformas PaqueteDuracionPlataforma[]
  precios                    Precio[]
  cuentas                    Cuenta[]
  pantallas                  Pantalla[]
  pantallasPlantilla         PlataformaPantalla[]
  ventas                     Venta[]
  ventaDetalles              VentaDetalle[]
  plantillasMensaje          PlantillaMensaje[]
  movimientoSaldos           MovimientoSaldo[]
  garantias                  Garantia[]

  @@unique([prefijoCodigo])
}

// empresaId es nulo únicamente para SUPER_ADMIN, que no pertenece a ninguna empresa.
model Usuario {
  id           String   @id @default(cuid())
  empresaId    String?
  email        String   @unique
  passwordHash String
  nombre       String
  rol          Rol
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())

  /// Se incrementa al cambiar la propia contraseña (PUT /perfil/contrasena).
  /// El JWT lleva el valor vigente al firmarse; si no coincide con este
  /// campo, la sesión quedó invalidada (ver plugins/contexto.ts). Es lo que
  /// permite "cerrar las demás sesiones" sin un almacén de sesiones aparte.
  versionSesion Int @default(1)

  /// OBSOLETA desde la división de roles VENDEDOR/EMPLEADO: la distinción
  /// revendedor-con-saldo vs. empleado-sin-tope ahora la da `rol` (VENDEDOR
  /// usa saldo, EMPLEADO nunca) — ver la migración de datos
  /// 20261009164941_rol_migrar_empleados_sin_saldo. Ningún archivo bajo
  /// src/ lee esta columna (ver lib/usa-saldo-lista-blanca.test.ts). No se
  /// borra porque hay filas históricas que todavía la tienen poblada.
  usaSaldo Boolean @default(false)
  /// Saldo vigente, en pesos. Los movimientos (MovimientoSaldo) son la
  /// historia; este campo es el valor actual, redundante a propósito para
  /// poder auditar sin recalcular (ver MovimientoSaldo.saldoResultante).
  saldo    Decimal @default(0) @db.Decimal(14, 2)

  empresa Empresa? @relation("UsuariosDeEmpresa", fields: [empresaId], references: [id])

  empresasCreadas Empresa[] @relation("EmpresasCreadas")

  ventasComoVendedor      Venta[]           @relation("VentaVendedor")
  ventasAnuladas          Venta[]           @relation("VentaAnuladaPor")
  movimientosSaldo        MovimientoSaldo[] @relation("MovimientoSaldoUsuario")
  movimientosSaldoCreados MovimientoSaldo[] @relation("MovimientoSaldoCreadoPor")
  garantiasCreadas        Garantia[]        @relation("GarantiaCreadaPor")

  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

/// nombreMensaje: nombre decorado para el mensaje de WhatsApp, ej. "N.E.T.F.L.I.X".
/// Si es null se usa `nombre`.
/// condiciones: texto que se muestra al vendedor antes de vender, ej. "1 pantalla. Solo TV".
/// usaPerfilPin: false para plataformas como Spotify, Canva, YouTube.
/// logoUrl: ruta bajo /logos/<archivo> (apps/web/public/logos/) o URL externa.
/// Null hasta que un admin la configure; sin logo el grid muestra una
/// pastilla con la inicial del nombre (vender/page.tsx), nunca un ícono roto.
model Plataforma {
  id                 String  @id @default(cuid())
  empresaId          String
  nombre             String
  nombreMensaje      String?
  condiciones        String?
  capacidadPantallas Int
  usaPerfilPin       Boolean @default(false)
  activa             Boolean @default(true)
  logoUrl            String?

  empresa Empresa @relation(fields: [empresaId], references: [id])

  paquetePlataformas         PaquetePlataforma[]
  paqueteDuracionPlataformas PaqueteDuracionPlataforma[]
  precios                    Precio[]
  cuentas                    Cuenta[]
  ventas                     Venta[]
  ventaDetalles              VentaDetalle[]
  pantallasPlantilla         PlataformaPantalla[]

  @@index([empresaId])
}

/// Plantilla de pantallas de una plataforma: todas las cuentas nuevas de esa
/// plataforma generan sus Pantalla copiando estas filas (numero, perfil,
/// pin). Editar la plantilla no toca ninguna Pantalla ya creada (R3: una
/// pantalla vendida ya entregó su PIN al comprador por WhatsApp) — ver
/// POST /cuentas en src/routes/cuentas.ts, que es el único lugar que lee
/// esta tabla para copiarla.
model PlataformaPantalla {
  id           String  @id @default(cuid())
  empresaId    String
  plataformaId String
  numero       Int
  perfil       String?
  /// Cifrado reversible (AES-256-GCM), igual que Pantalla.pin.
  pin          String?

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])

  @@unique([plataformaId, numero])
  @@index([empresaId])
}

model Duracion {
  id        String         @id @default(cuid())
  empresaId String
  nombre    String
  cantidad  Int
  unidad    UnidadDuracion
  activa    Boolean        @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  precios                Precio[]
  paqueteDuracionVendida PaqueteDuracionPlataforma[] @relation("DuracionVendida")
  paqueteDuracionReal    PaqueteDuracionPlataforma[] @relation("DuracionReal")
  ventas                 Venta[]
  ventaDetalles          VentaDetalle[]

  @@index([empresaId])
}

model TipoCliente {
  id        String  @id @default(cuid())
  empresaId String
  nombre    String
  activo    Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  precios Precio[]
  ventas  Venta[]

  @@index([empresaId])
}

model Paquete {
  id          String  @id @default(cuid())
  empresaId   String
  nombre      String
  descripcion String?
  activo      Boolean @default(true)
  /// Qué ES este ítem hoy. No confundir con Venta.esPromocion, que es la
  /// copia inmutable de QUÉ ERA al momento de vender (R3).
  esPromocion Boolean @default(false)

  empresa Empresa @relation(fields: [empresaId], references: [id])

  paquetePlataformas         PaquetePlataforma[]
  paqueteDuracionPlataformas PaqueteDuracionPlataforma[]
  precios                    Precio[]
  ventas                     Venta[]

  @@index([empresaId])
}

/// Composición del paquete: qué plataformas lo integran y cuántas pantallas de cada una.
model PaquetePlataforma {
  id                String @id @default(cuid())
  empresaId         String
  paqueteId         String
  plataformaId      String
  cantidadPantallas Int    @default(1)

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  paquete    Paquete    @relation(fields: [paqueteId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])

  @@unique([paqueteId, plataformaId])
  @@index([empresaId])
}

/// Excepciones de duración por plataforma dentro de un paquete.
/// Solo lleva filas donde la duración real DIFIERE de la duración vendida.
/// Ej.: paquete "Básico 1" vendido a "30 días" (duracionVendidaId) con
/// Netflix (plataformaId) resolviendo a "28 días" (duracionRealId).
model PaqueteDuracionPlataforma {
  id                String @id @default(cuid())
  empresaId         String
  paqueteId         String
  duracionVendidaId String
  plataformaId      String
  duracionRealId    String

  empresa         Empresa    @relation(fields: [empresaId], references: [id])
  paquete         Paquete    @relation(fields: [paqueteId], references: [id])
  duracionVendida Duracion   @relation("DuracionVendida", fields: [duracionVendidaId], references: [id])
  plataforma      Plataforma @relation(fields: [plataformaId], references: [id])
  duracionReal    Duracion   @relation("DuracionReal", fields: [duracionRealId], references: [id])

  @@unique([paqueteId, duracionVendidaId, plataformaId])
  @@index([empresaId])
}

/// Precio sirve tanto para plataformas individuales como para paquetes.
/// plataformaId y paqueteId son ambos nullable: exactamente uno debe estar
/// presente. Esa restricción se aplica con un CHECK de Postgres agregado en
/// una migración SQL manual (Prisma no expresa CHECK arbitrarios en el
/// esquema) — ver prisma/migrations/*_check_precio_plataforma_xor_paquete.
model Precio {
  id            String  @id @default(cuid())
  empresaId     String
  plataformaId  String?
  paqueteId     String?
  duracionId    String
  tipoClienteId String
  precioVenta   Decimal @db.Decimal(14, 2)
  costo         Decimal @db.Decimal(14, 2)
  activo        Boolean @default(true)

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  plataforma  Plataforma? @relation(fields: [plataformaId], references: [id])
  paquete     Paquete?    @relation(fields: [paqueteId], references: [id])
  duracion    Duracion    @relation(fields: [duracionId], references: [id])
  tipoCliente TipoCliente @relation(fields: [tipoClienteId], references: [id])

  @@unique([empresaId, plataformaId, duracionId, tipoClienteId])
  @@unique([empresaId, paqueteId, duracionId, tipoClienteId])
  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// Inventario
// ---------------------------------------------------------------------------

model Cuenta {
  id                 String   @id @default(cuid())
  empresaId          String
  plataformaId       String
  correo             String
  /// Cifrado reversible (AES-256-GCM), no hash — ver src/lib/cifrado.ts.
  password           String
  capacidadPantallas Int
  notas              String?
  activa             Boolean  @default(true)
  createdAt          DateTime @default(now())

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])

  pantallas     Pantalla[]
  ventaDetalles VentaDetalle[]

  @@index([empresaId])
}

/// Unidad de inventario. Perfil y PIN son null cuando la plataforma no usa
/// perfiles (Plataforma.usaPerfilPin = false).
model Pantalla {
  id        String  @id @default(cuid())
  empresaId String
  cuentaId  String
  numero    Int
  perfil    String?
  /// Cifrado reversible (AES-256-GCM), no hash.
  pin       String?
  activa    Boolean @default(true)

  empresa Empresa @relation(fields: [empresaId], references: [id])
  cuenta  Cuenta  @relation(fields: [cuentaId], references: [id])

  ventaDetalles VentaDetalle[]

  @@unique([cuentaId, numero])
  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// Ventas
// ---------------------------------------------------------------------------

/// Guarda copia de precioVenta, costo, utilidad, cantidadDuracion,
/// unidadDuracion, nombreItem, nombreDuracion y nombreTipoCliente al momento
/// de la venta (R3): esos campos nunca se actualizan después de creados.
///
/// fechaVencimientoMax = mayor vencimiento de sus VentaDetalle. Es un valor
/// derivado que se escribe una sola vez al crear la venta, solo para filtrar
/// y ordenar listados. La disponibilidad de una pantalla NUNCA se calcula con
/// este campo — usar siempre VentaDetalle.fechaVencimiento (R5).
model Venta {
  id            String    @id @default(cuid())
  empresaId     String
  vendedorId    String
  codigoCompra  String
  tipoVenta     TipoVenta
  plataformaId  String?
  paqueteId     String?
  duracionId    String
  tipoClienteId String

  // Copias inmutables al momento de la venta (R3).
  nombreItem        String
  nombreDuracion    String
  cantidadDuracion  Int
  unidadDuracion    UnidadDuracion
  nombreTipoCliente String
  precioVenta       Decimal        @db.Decimal(14, 2)
  costo             Decimal        @db.Decimal(14, 2)
  utilidad          Decimal        @db.Decimal(14, 2)
  /// Copia de Paquete.esPromocion al momento de vender. Si el admin
  /// desmarca la promoción después, esta venta sigue contando como
  /// promoción (R3). Siempre false para tipoVenta UNIDAD.
  esPromocion       Boolean        @default(false)

  /// Celular del comprador final, opcional. Primer dato personal del
  /// comprador que guarda el sistema: solo visible para el vendedor autor
  /// de la venta y para ADMIN/SUPER_ADMIN (R4).
  celularCliente String?

  fechaVenta          DateTime @default(now())
  /// Derivado, solo para filtrar/ordenar. NUNCA usar para disponibilidad (R5).
  fechaVencimientoMax DateTime

  mensajeGenerado String @db.Text

  anulada      Boolean   @default(false)
  anuladaPorId String?
  anuladaEn    DateTime?
  createdAt    DateTime  @default(now())

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  vendedor    Usuario     @relation("VentaVendedor", fields: [vendedorId], references: [id])
  anuladaPor  Usuario?    @relation("VentaAnuladaPor", fields: [anuladaPorId], references: [id])
  plataforma  Plataforma? @relation(fields: [plataformaId], references: [id])
  paquete     Paquete?    @relation(fields: [paqueteId], references: [id])
  duracion    Duracion    @relation(fields: [duracionId], references: [id])
  tipoCliente TipoCliente @relation(fields: [tipoClienteId], references: [id])

  detalles         VentaDetalle[]
  movimientosSaldo MovimientoSaldo[]

  @@unique([empresaId, codigoCompra])
  @@index([empresaId])
}

/// Una fila por pantalla asignada. Cada renglón lleva SU PROPIA duración y
/// fecha de vencimiento (R5/D14): un combo puede tener Netflix a 28 días y
/// Disney+ a 30 días en la misma venta. Guarda copia de nombrePlataforma,
/// correoCuenta, passwordCuenta, perfil y pin — inmutables (R3).
model VentaDetalle {
  id           String @id @default(cuid())
  empresaId    String
  ventaId      String
  pantallaId   String
  cuentaId     String
  plataformaId String

  // Copias inmutables al momento de la venta (R3).
  nombrePlataforma String
  correoCuenta     String
  /// Cifrado reversible (AES-256-GCM), copiado de Cuenta.password al vender.
  passwordCuenta   String
  perfil           String?
  /// Cifrado reversible (AES-256-GCM), copiado de Pantalla.pin al vender.
  pin              String?

  duracionId       String
  cantidadDuracion Int
  unidadDuracion   UnidadDuracion
  /// Fuente de verdad de disponibilidad (R5): ocupada si venta no anulada y
  /// fechaVencimiento > now().
  fechaVencimiento DateTime

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  venta      Venta      @relation(fields: [ventaId], references: [id])
  pantalla   Pantalla   @relation(fields: [pantallaId], references: [id])
  cuenta     Cuenta     @relation(fields: [cuentaId], references: [id])
  plataforma Plataforma @relation(fields: [plataformaId], references: [id])
  duracion   Duracion   @relation(fields: [duracionId], references: [id])

  /// Presente si esta pantalla falló y fue reemplazada (este renglón es el ORIGINAL).
  garantiaOriginal  Garantia? @relation("GarantiaOriginal")
  /// Presente si este renglón fue entregado como reemplazo de una garantía.
  garantiaReemplazo Garantia? @relation("GarantiaReemplazo")

  @@index([empresaId])
  @@index([pantallaId, fechaVencimiento])
}

/// Reemplazo de una pantalla que dejó de funcionar para el comprador (R3): el
/// VentaDetalle original nunca se toca — ni su pantallaId, ni sus
/// credenciales, ni su fechaVencimiento. El reemplazo es un VentaDetalle
/// NUEVO sobre la MISMA venta; esta fila es el hecho que conecta ambos.
///
/// ventaDetalleOriginalId es único: una pantalla entregada no se reemplaza
/// dos veces. Si el reemplazo también falla, la garantía siguiente apunta al
/// renglón de reemplazo, que es otro id.
model Garantia {
  id                      String   @id @default(cuid())
  empresaId               String
  ventaDetalleOriginalId  String   @unique
  ventaDetalleReemplazoId String   @unique
  motivo                  String?
  /// Costo de la plataforma/duración al momento de la garantía — copia
  /// inmutable (R3). Es la pérdida que asume la empresa; NO se resta de
  /// Venta.utilidad de la venta original, que es historia y no se edita.
  costoAsumido            Decimal  @db.Decimal(14, 2)
  mensajeGenerado         String   @db.Text
  creadoPorId             String
  createdAt               DateTime @default(now())

  empresa               Empresa      @relation(fields: [empresaId], references: [id])
  ventaDetalleOriginal  VentaDetalle @relation("GarantiaOriginal", fields: [ventaDetalleOriginalId], references: [id])
  ventaDetalleReemplazo VentaDetalle @relation("GarantiaReemplazo", fields: [ventaDetalleReemplazoId], references: [id])
  creadoPor             Usuario      @relation("GarantiaCreadaPor", fields: [creadoPorId], references: [id])

  @@index([empresaId])
}

/// Texto exacto por tipo de venta, con placeholders {{...}}. Editar la
/// plantilla no cambia Venta.mensajeGenerado de ventas ya registradas (R3).
model PlantillaMensaje {
  id            String        @id @default(cuid())
  empresaId     String
  tipo          TipoPlantilla
  contenido     String        @db.Text
  actualizadaEn DateTime      @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, tipo])
  @@index([empresaId])
}

/// Saldo del "Saldo" (crédito prepago de revendedores). `Usuario.saldo` es el
/// valor vigente; esta tabla es la historia inmutable: un movimiento pasado
/// NUNCA se edita ni se borra, un error se corrige con un AJUSTE nuevo.
///
/// `saldoResultante` es redundante a propósito: es lo que permite auditar el
/// ledger sin recalcular toda la historia (ver prueba de cuadre de ledger).
///
/// No se copia nada de esto a Venta (R3 no aplica aquí): `ventaId` ya
/// responde "qué venta generó este movimiento", y Venta es inmutable por
/// construcción. `ventaId` está presente en CONSUMO y DEVOLUCION, nulo en
/// CARGA y AJUSTE. `nota` es obligatoria en AJUSTE (se exige en la capa de
/// aplicación: Prisma no expresa nulabilidad condicional).
///
/// La restricción única (empresaId, ventaId, tipo) hace estructuralmente
/// imposible cobrar dos veces la misma venta o devolverle el saldo dos
/// veces, incluso bajo una carrera — ver restriccionViolada() en errores.ts.
model MovimientoSaldo {
  id              String              @id @default(cuid())
  empresaId       String
  usuarioId       String
  tipo            TipoMovimientoSaldo
  monto           Decimal             @db.Decimal(14, 2)
  saldoResultante Decimal             @db.Decimal(14, 2)
  ventaId         String?
  nota            String?
  creadoPorId     String
  createdAt       DateTime            @default(now())

  empresa   Empresa @relation(fields: [empresaId], references: [id])
  usuario   Usuario @relation("MovimientoSaldoUsuario", fields: [usuarioId], references: [id])
  venta     Venta?  @relation(fields: [ventaId], references: [id])
  creadoPor Usuario @relation("MovimientoSaldoCreadoPor", fields: [creadoPorId], references: [id])

  @@unique([empresaId, ventaId, tipo])
  @@index([empresaId])
  @@index([usuarioId])
}
